# .dockerignore — Budlance
# Prevents secrets, dev artifacts, and unneeded files from entering the Docker build context.

# Secrets — never copy into image
.env
.env.*
!.env.example

# Virtual environment — image installs its own
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/

# Test artifacts
tests/
.pytest_cache/
.coverage
htmlcov/

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# Git
.git/
.gitignore

# Documentation (not needed at runtime)
docs/
*.md

# Typing / linting caches
.mypy_cache/
.ruff_cache/
